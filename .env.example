# ==========================================
# StreamShare Configuration Template
# ==========================================

# --- Default Stream Source Selection ---
DEFAULT_SOURCE_PLATFORM=twitch
DEFAULT_SOURCE_IDENTIFIER=your_streamer_username

# --- Twitch API Credentials ---
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
# Optional: resolutions to fetch for twitch images
TWITCH_THUMBNAIL_RESOLUTION=1920x1080
TWITCH_BOXART_RESOLUTION=600x800

# --- TikTok Live Configuration ---
# Optional: Session cookies are required to fetch streams when unauthenticated requests are blocked.
# Locate these in your browser cookies under .tiktok.com.
TIKTOK_SESSION_ID=your_sessionid_cookie
TIKTOK_TARGET_IDC=your_tt_target_idc
TIKTOK_SIGN_HOST=tiktok.eulerstream.com

# --- YouTube Live Configuration ---
# Optional: YouTube API Key for fallback stream metadata check.
YOUTUBE_API_KEY=your_youtube_api_key

# --- Instagram Publisher Credentials ---
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
# Optional: TOTP secret to automatically generate 2FA login codes
INSTAGRAM_TOTP_SECRET=your_totp_secret

# --- Twitter/X API Credentials (OAuth 1.0a User Context) ---
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# --- Discord Webhook Credentials (Optional) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# --- Security ---
# Optional: master key used to encrypt stored sessions at rest.
# If unset, a random key is generated and persisted to data/jwt_secret.txt.
SECRET_KEY=

# --- Storage ---
# Optional: base directory for generated images, artwork cache, and sessions.
# Defaults to ./data (with generated_images/ and artwork_images/ legacy dirs
# in the working directory still supported).
STREAMSHARE_DATA_DIR=

# --- Multi-account publishing (optional) ---
# Configure extra accounts per platform with the <PLATFORM>_<ID>_<FIELD>
# naming scheme; 'default' is used when only the plain variables are set.
# INSTAGRAM_BRAND_USERNAME=...
# INSTAGRAM_BRAND_PASSWORD=...
# INSTAGRAM_BRAND_ENABLED=true
# TWITTER_BRAND_API_KEY=...
# TWITTER_BRAND_API_SECRET=...
# TWITTER_BRAND_ACCESS_TOKEN=...
# TWITTER_BRAND_ACCESS_TOKEN_SECRET=...
# TWITTER_BRAND_ENABLED=true
# DISCORD_COMMUNITY_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_COMMUNITY_ENABLED=true
